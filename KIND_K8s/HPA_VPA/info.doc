------------ Horizontal Pod AutoScaling & Vertical Pod AutoScaling ------------

----------- Setting up the metrics server

For looking at the metrics we have this commmand: kubectl top node

- root@controlplane:~/k8s-cluster$ kubectl get nodes
NAME                        STATUS     ROLES           AGE   VERSION
k8s-cluster-control-plane   Ready      control-plane   31s   v1.35.0
k8s-cluster-worker          NotReady   <none>          18s   v1.35.0

- root@controlplane:~/k8s-cluster$ kubectl top node
error: Metrics API not available
root@controlplane:~/k8s-cluster$ 

- root@controlplane:~/k8s-cluster$ kubectl top pod 
error: Metrics API not available
root@controlplane:~/k8s-cluster$ 

So, for that we need a "Metrics Server", u can directly run this on terminal :- 
kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

Follow this guide to apply the metrics server :-
Link :- https://github.com/LondheShubham153/kubestarter/blob/main/HPA_VPA/README.md

-----------------------------------------

-------------------------- HPA ---------------------------

--> vim namespace.yml
-->
kind: Namespace
apiVersion: v1
metadata:
  name: apache

---

. Then run this command :-  kubectl apply -f namespace.yml


--> vim deployment.yml
-->
kind: Deployment
apiVersion: apps/v1
metadata:
  name: apache-deployment
  namespace: apache

spec:
  replicas: 1   

  selector:
    matchLabels:
      app: apache

  template:
    metadata:
      labels:        
        app: apache

    spec:
      containers:
      - name: apache
        image: httpd:latest
        ports:
        - containerPort: 80

        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 200m
            memory: 256Mi
---

. Then run this command :-  kubectl apply -f deployment.yml


Now we want to publically access this pod so for this we need service.yml

--> vim service.yml
-->
kind: Service
apiVersion: v1
metadata:
  name: apache-service
  namespace: apache

spec:
  selector: 
    app: apache

  ports:
    - protocol: TCP
      port: 80   # Exposed port in the cluster
      targetPort: 80  # container port
  type: ClusterIP
---

. Then run this command :-  kubectl apply -f service.yml

root@controlplane:~/k8s-cluster$ kubectl get all -n apache        
NAME                                     READY   STATUS    RESTARTS   AGE
pod/apache-deployment-856cfb8c57-twbff   1/1     Running   0          14m

NAME                     TYPE        CLUSTER-IP     EXTERNAL-IP   PORT(S)   AGE
service/apache-service   ClusterIP   10.96.46.138   <none>        80/TCP    91s

NAME                                READY   UP-TO-DATE   AVAILABLE   AGE
deployment.apps/apache-deployment   1/1     1            1           14m

NAME                                           DESIRED   CURRENT   READY   AGE
replicaset.apps/apache-deployment-856cfb8c57   1         1         1       14m
root@controlplane:~/k8s-cluster$ 


---- Scale up the deployment by manually

root@controlplane:~/k8s-cluster$ kubectl scale deployment apache-deployment -n apache --replicas=3
deployment.apps/apache-deployment scaled
root@controlplane:~/k8s-cluster$ kubectl get pods -n apache
NAME                                 READY   STATUS    RESTARTS   AGE
apache-deployment-856cfb8c57-fb6q7   1/1     Running   0          10s
apache-deployment-856cfb8c57-jb8z5   1/1     Running   0          10s
apache-deployment-856cfb8c57-twbff   1/1     Running   0          21m


---- Scale up the deployment by Horizontal Pod AutoScaling

--> vim hpa.yml
-->
apiVersion: autoscaling/v2
kind: HorizontalPodAutocaler

metadata:
  name: apache=hpa
  namespace: apache
   
spec:
  # which u want to scale up either pod, deployment, replicaSet, StatefulSet etc
  scaleTargetRef:
    kind: Deployment
    name: apache-deployment
    apiVersion: apps/v1

  minReplicas: 1
  maxReplicas: 5

  # Also define metrics because on which basis they will scale-up the 5 replicas
  metrics:
    - type: Resource 
      resource:
        name: cpu
        target: 
          type: Utilization
          averageUtilization: 5  # if my cpu utilization reach around 5% so pls make a replica of it 
---

