--------------------- K8s Service ---------------------

kind: Service
apiVersion: v1
metadata:
  name: nginx-service
  namespace: nginx-dev
spec:
  selector:
    app: nginx
  ports:
    - protocol: TCP
      port: 80      # external service port so that outer world can access. 
      targetPort: 80  # pod target port which u want to bound.
  type: ClusterIP

--------------------------------------------------

------- Command if u want to see everything (pod, deployment, service) ------

root@controlplane:~/k8s_cluster$ kubectl get all -n nginx-dev -o wide
NAME                                    READY   STATUS    RESTARTS   AGE
pod/nginx-deployment-55665dbc57-m9lrm   1/1     Running   0          89s
pod/nginx-deployment-55665dbc57-shpf5   1/1     Running   0          90s

NAME                 TYPE        CLUSTER-IP    EXTERNAL-IP   PORT(S)   AGE
service/my-service   ClusterIP   10.96.33.48   <none>        80/TCP    28s

NAME                               READY   UP-TO-DATE   AVAILABLE   AGE
deployment.apps/nginx-deployment   2/2     2            2           90s

NAME                                          DESIRED   CURRENT   READY   AGE
replicaset.apps/nginx-deployment-55665dbc57   2         2         2       90s
root@controlplane:~/k8s_cluster$ 

- kubectl get svc -n notes-app

--------------------------------------------------


------- Command to expose the local container port to everyone ------

root@controlplane:~/k8s_cluster$ kubectl port-forward service/nginx-service -n nginx-dev 80:80 --address=0.0.0.0 
Forwarding from 0.0.0.0:80 -> 80

ways to know the IP address :- hostname -I

